{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MineCircuit",
  "version": "../package.json",
  "identifier": "io.github.p0ngch4ng.minecircuit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MineCircuit（非公式）",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data:",
        "media-src": "'none'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data: ws://localhost:5173",
        "media-src": "'none'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "P0ngCh4ng",
    "copyright": "Copyright (c) 2026 P0ngCh4ng. MIT License.",
    "category": "Utility",
    "shortDescription": "Create などの設計図を確認・編集・計算する非公式ツール",
    "longDescription": "MineCircuit は、工業Mod（Create など）の設計図をゲームの外で確認・編集・計算する非公式のツールです。Mojang Studios・Microsoft、および各Modの作者とは関係がありません。ファイルは PC の中だけで処理し、外部に送信しません。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
