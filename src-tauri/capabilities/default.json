{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "MineCircuit のメインウィンドウに許可する操作。ネットワーク・シェル・自動更新は許可しない。ファイルは、ダイアログで利用者が選んだ場所だけを読み書きできる（固定の読み書きの範囲は持たない）。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:allow-write-file"
  ]
}
